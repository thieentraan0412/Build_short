 "lines": [
  {
   "id": "L01",
   "who": "loupe",
   "t": 0.45,
   "dur": 1.968,
   "card": 1,
   "text": "Where does a grasshopper hide its ears?"
  },
  {
   "id": "L02",
   "who": "loupe",
   "t": 3.9,
   "dur": 0.999,
   "card": 2,
   "text": "Let's zoom in!",
   "catch": true
  },
  {
   "id": "L03",
   "who": "crumb",
   "t": 4.95,
   "dur": 1.551,
   "card": 3,
   "text": "Are they on its legs, like Chirp?"
  },
  {
   "id": "L04",
   "who": "loupe",
   "t": 7.25,
   "dur": 0.628,
   "card": 3,
   "text": "Nope!",
   "catch": true
  },
  {
   "id": "L05",
   "who": "loupe",
   "t": 8.05,
   "dur": 1.517,
   "card": 4,
   "text": "Its ears are on its tummy!"
  },
  {
   "id": "L06",
   "who": "crumb",
   "t": 10.4,
   "dur": 1.219,
   "card": 5,
   "text": "But WHY on its tummy?"
  },
  {
   "id": "L07",
   "who": "loupe",
   "t": 12,
   "dur": 1.72,
   "card": 6,
   "text": "To hear other grasshoppers sing!"
  },
  {
   "id": "L08",
   "who": "loupe",
   "t": 14.65,
   "dur": 2.129,
   "card": 7,
   "text": "Many grasshoppers sing with their legs!"
  },
  {
   "id": "L09",
   "who": "loupe",
   "t": 16.9,
   "dur": 1.641,
   "card": 8,
   "text": "They rub a back leg on a wing!"
  },
  {
   "id": "L10",
   "who": "loupe",
   "t": 20.4,
   "dur": 1.916,
   "card": 9,
   "text": "And its back legs are like springs!"
  },
  {
   "id": "L11",
   "who": "crumb",
   "t": 23.05,
   "dur": 1.011,
   "card": 10,
   "text": "Look at it go!"
  },
  {
   "id": "L12",
   "who": "crumb",
   "t": 24.6,
   "dur": 0.867,
   "card": 11,
   "text": "A bug band!"
  },
  {
   "id": "L13",
   "who": "loupe",
   "t": 25.75,
   "dur": 1.351,
   "card": 12,
   "text": "The notes make a heart!"
  },
  {
   "id": "L14",
   "who": "albie",
   "t": 29.8,
   "dur": 2.297,
   "card": 13,
   "text": "Six legs? In you go!",
   "catch": true
  },
  {
   "id": "L15",
   "who": "crumb",
   "t": 33.35,
   "dur": 1.185,
   "card": 14,
   "text": "Play it again! Louder!"
  },
  {
   "id": "L16",
   "who": "loupe",
   "t": 37.45,
   "dur": 1.162,
   "card": 15,
   "text": "Oops! Too loud!"
  },
  {
   "id": "L17",
   "who": "loupe",
   "t": 39.35,
   "dur": 1,
   "card": 16,
   "text": "Where are YOUR ears?"
  }
 ],
