   "id": "L043",
   "who": "crumb",
   "t": 99.418,
   "dur": 1.447,
   "text": "So we can find our way back!",
   "card": 25
  },
  {
   "id": "L044",
   "who": "loupe",
   "t": 101.865,
   "dur": 2.389,
   "text": "I see close things... not far things!",
   "card": 26
  },
  {
   "id": "L045",
   "who": "loupe",
   "t": 104.554,
   "dur": 1.553,
   "text": "I wish cousin Telly were here!",
   "card": 26
  },
