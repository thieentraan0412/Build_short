  },
  {
   "id": "L086",
   "who": "loupe",
   "t": 220.608,
   "dur": 2.015,
   "text": "Two little antennae, sniff and see...",
   "chant": true,
   "card": 53
  },
  {
   "id": "L087",
   "who": "albie",
   "t": 222.923,
   "dur": 2.245,
   "text": "That's a bug! That's a bug!",
   "chant": true,
   "card": 53
  },
  {
   "id": "L088",
   "who": "albie",
   "t": 225.868,
   "dur": 3.056,
   "text": "BZZT! Not you, Spindle!",
   "chant": true,
