 "lines": [
  {
   "id": "L001",
   "who": "loupe",
   "t": 0.15,
   "dur": 1.659,
   "text": "Whoa! Rollo! I can't stop!",
   "card": 1
  },
  {
   "id": "L002",
   "who": "crumb",
   "t": 2.259,
   "dur": 1.343,
   "text": "Can I hold the lens?",
   "card": 1
  },
  {
   "id": "L003",
   "who": "loupe",
   "t": 3.752,
   "dur": 0.778,
   "text": "Not NOW!",
   "card": 1
  },
  {
   "id": "L004",
   "who": "albie",
   "t": 5.38,
   "dur": 2.647,
   "text": "Miss Loupe is lost... at NIGHT!",
   "card": 2
  },
  {
   "id": "L005",
   "who": "crumb",
   "t": 8.327,
   "dur": 1.551,
   "text": "How do we find her... with no sun?",
   "card": 2
  },
  {
   "id": "L006",
   "who": "rollo",
   "t": 10.928,
   "dur": 2.753,
   "text": "Oh my. My ball feels... lighter.",
   "card": 3
  },
  {
   "id": "L007",
   "who": "loupe",
   "t": 13.981,
   "dur": 1.707,
   "text": "Big secrets of tiny bugs!",
   "card": 4
  },
  {
   "id": "L008",
   "who": "albie",
   "t": 16.288,
   "dur": 1.614,
   "text": "My garden map!",
   "card": 5
  },
  {
   "id": "L009",
   "who": "albie",
   "t": 18.202,
   "dur": 2.076,
   "text": "We are here... at home.",
   "card": 5
  },
  {
   "id": "L010",
   "who": "crumb",
   "t": 20.578,
   "dur": 0.836,
   "text": "And Miss Loupe?",
   "card": 5
  },
  {
   "id": "L011",
   "who": "rollo",
   "t": 22.014,
   "dur": 2.338,
   "text": "She flew off... straight that way.",
   "card": 6
  },
  {
   "id": "L012",
   "who": "albie",
   "t": 25.452,
   "dur": 1.335,
   "text": "Off my map?!",
   "card": 7
  },
  {
   "id": "L013",
   "who": "crumb",
   "t": 27.087,
   "dur": 1.524,
   "text": "I'll lead the way! I'll find her!",
   "card": 7
  },
  {
   "id": "L014",
   "who": "dot",
   "t": 29.711,
   "dur": 2.185,
   "text": "Team, count off! One, two, three, four, five!",
   "card": 8
  },
  {
   "id": "L015",
   "who": "blink",
   "t": 32.496,
   "dur": 0.875,
   "text": "I'll be the light!",
   "card": 8
  },
  {
   "id": "L016",
   "who": "albie",
   "t": 34.021,
   "dur": 3.015,
   "text": "I'll keep the map. Come home safe!",
   "card": 9
  },
  {
   "id": "L017",
   "who": "crumb",
   "t": 38.036,
   "dur": 1.254,
   "text": "Waggle wants to dance!",
   "card": 10
  },
  {
   "id": "L018",
   "who": "crumb",
   "t": 41.59,
   "dur": 1.472,
   "text": "Bees dance to show the way...",
   "card": 11
  },
  {
   "id": "L019",
   "who": "crumb",
   "t": 43.312,
   "dur": 0.986,
   "text": "using the sun!",
   "card": 11
  },
  {
   "id": "L020",
   "who": "crumb",
   "t": 44.698,
   "dur": 1.258,
   "text": "Can you find the sun?",
   "card": 11
  },
  {
   "id": "L021",
   "who": "blink",
   "t": 48.256,
   "dur": 0.542,
   "text": "Nope!",
   "catch": true,
   "card": 12
  },
  {
   "id": "L022",
   "who": "rollo",
   "t": 50.098,
   "dur": 1.945,
   "text": "No sun tonight, little bee.",
   "card": 13
  },
  {
   "id": "L023",
   "who": "crumb",
   "t": 52.343,
   "dur": 1.545,
   "text": "Then I'll use my antennae!",
   "card": 13
  },
  {
   "id": "L024",
   "who": "loupe",
   "t": 54.688,
   "dur": 1.838,
   "text": "I'm lost... so I stay put.",
   "card": 14
  },
  {
   "id": "L025",
   "who": "loupe",
   "t": 56.826,
   "dur": 1.344,
   "text": "My friends will find me!",
   "card": 14
  },
  {
   "id": "L026",
   "who": "crumb",
   "t": 59.37,
   "dur": 1.438,
   "text": "Ants follow smell trails!",
   "card": 15
  },
  {
   "id": "L027",
   "who": "crumb",
   "t": 61.108,
   "dur": 1.228,
   "text": "Sniff, sniff... this way!",
   "card": 15
  },
  {
   "id": "L028",
   "who": "crumb",
   "t": 63.836,
   "dur": 1.49,
   "text": "My family! Hi, everyone!",
   "card": 16
  },
  {
   "id": "L029",
   "who": "dot",
   "t": 65.626,
   "dur": 1.984,
   "text": "One, two, three, four, five, six ants!",
   "card": 16
  },
  {
   "id": "L030",
   "who": "crumb",
   "t": 69.01,
   "dur": 1.048,
   "text": "Follow the trail...",
   "card": 17
  },
  {
   "id": "L031",
   "who": "crumb",
   "t": 70.758,
   "dur": 0.915,
   "text": "under the leaf...",
   "card": 17
  },
  {
   "id": "L032",
   "who": "crumb",
   "t": 72.373,
   "dur": 0.958,
   "text": "over the pebble!",
   "card": 18
  },
  {
   "id": "L033",
   "who": "crumb",
   "t": 75.631,
   "dur": 1.176,
   "text": "The trail ends here!",
   "card": 19
  },
