   "id": "L040",
   "who": "dot",
   "t": 93.857,
   "dur": 1.569,
   "text": "One, two, three, four, five...",
   "card": 24
  },
  {
   "id": "L041",
   "who": "dot",
   "t": 95.526,
   "dur": 1.565,
   "text": "six, seven, eight, nine, ten!",
   "card": 24
  },
