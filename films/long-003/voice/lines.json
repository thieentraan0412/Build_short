  "pitch": 5
 },
 {
  "id": "L036",
  "who": "crumb",
  "text": "My cousins in the desert...",
  "voice": "af_jessica",
  "speed": 0.85,
  "pitch": 5
 },
 {
  "id": "L037",
  "who": "crumb",
