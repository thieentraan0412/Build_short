  "speed": 0.85,
  "pitch": 5
 },
 {
  "id": "L039",
  "who": "dot",
  "text": "I count steps too!",
  "voice": "bf_isabella",
  "speed": 0.9,
  "pitch": 3.5
 },
 {
  "id": "L040",
  "who": "dot",
  "text": "One, two, three, four, five...",
  "voice": "bf_isabella",
  "speed": 0.9,
  "pitch": 3.5
 },
 {
  "id": "L041",
  "who": "dot",
  "text": "six, seven, eight, nine, ten!",
