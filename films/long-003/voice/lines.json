  "speed": 0.85,
  "pitch": 5
 },
 {
  "id": "L024",
  "who": "loupe",
  "text": "I'm lost... so I stay put.",
  "voice": "af_heart",
  "speed": 0.9
 },
 {
  "id": "L025",
  "who": "loupe",
  "text": "My friends will find me!",
  "voice": "af_heart",
  "speed": 0.9
 },
 {
