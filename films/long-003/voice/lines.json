  "speed": 0.85,
  "pitch": 5
 },
 {
  "id": "L021",
  "who": "blink",
  "text": "Nope!",
  "voice": "bf_lily",
  "speed": 1,
  "pitch": 8
 },
 {
  "id": "L022",
  "who": "rollo",
