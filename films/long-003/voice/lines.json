  "speed": 1,
  "pitch": 8
 },
 {
  "id": "L016",
  "who": "albie",
  "text": "I'll keep the map. Come home safe!",
  "voice": "bm_lewis",
  "speed": 0.8
 },
 {
  "id": "L017",
  "who": "crumb",
  "text": "Waggle wants to dance!",
